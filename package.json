{
  "name": "ai-ttrpg-table",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,room \"vite\" \"node --watch server.mjs --dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "eval:canon": "node --env-file-if-exists=.env.local scripts/eval-canon.mjs",
    "eval:continuity": "node --env-file-if-exists=.env.local scripts/eval-continuity.mjs",
    "eval:contradictions": "node --env-file-if-exists=.env.local scripts/eval-contradictions.mjs",
    "eval:recap": "node --env-file-if-exists=.env.local scripts/eval-recap.mjs",
    "eval:knowledge": "node --env-file-if-exists=.env.local scripts/eval-knowledge.mjs",
    "eval:intent": "node --env-file-if-exists=.env.local scripts/eval-intent.mjs",
    "eval:house-rules": "node --env-file-if-exists=.env.local scripts/eval-house-rules.mjs",
    "eval:factions": "node --env-file-if-exists=.env.local scripts/eval-factions.mjs",
    "eval:all": "node --env-file-if-exists=.env.local scripts/eval-all.mjs",
    "eval:feedback": "node --env-file-if-exists=.env.local scripts/eval-feedback.mjs",
    "eval:record": "node --env-file-if-exists=.env.local scripts/record-evaluation.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "openai": "^6.48.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "9.2.4",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
